OPENAI_API_KEY=sk-or-v1-...your-openrouter-key-here...
OPENAI_URL=https://openrouter.ai/api/v1/
MODEL_NAME=qwen/qwen3-8b
STRUCTURED_OUTPUT_METHOD=json_schema
LOG_LEVEL=INFO

# --- Qwen3-8B knobs (https://huggingface.co/Qwen/Qwen3-8B) ---
# Thinking mode emits <think>...</think> blocks before the answer. Default off:
# safer for structured output unless the upstream provider strips reasoning tags.
# Soft switches /think and /no_think in user prompts only work when this is true.
ENABLE_THINKING=false
MAX_TOKENS=32768

# Leave the sampling knobs blank to use Qwen3 model-card defaults:
#   thinking on : temperature=0.6 top_p=0.95 top_k=20 min_p=0
#   thinking off: temperature=0.7 top_p=0.8  top_k=20 min_p=0
# Set explicitly to override. Greedy decoding (temp=0) is discouraged.
# TEMPERATURE=
# TOP_P=
# TOP_K=
# MIN_P=
# PRESENCE_PENALTY=     # 0–2 reduces repetitions; high values may cause language mixing
